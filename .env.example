# Reference only: MergeLane does not load .env files automatically.
# Export these variables in your shell or configure your MCP client's environment.
# Store credentials outside the repository; on Unix use mode 0600 or 0400.
GITEA_URL=https://git.example.com
GITEA_TOKEN_FILE=/absolute/path/outside/repository/gitea-token

# Plane can be configured alone or together with Gitea.
# PLANE_URL=https://plane.example.com
# PLANE_TOKEN_FILE=/absolute/path/outside/repository/plane-api-key
# PLANE_WORKSPACE=team

# Every backend can be configured independently or together.
# GITHUB_URL=https://github.com
# GITHUB_TOKEN_FILE=/absolute/path/outside/repository/github-token
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN_FILE=/absolute/path/outside/repository/gitlab-token
# JIRA_URL=https://team.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_TOKEN_FILE=/absolute/path/outside/repository/jira-token
# Set the site Cloud ID for scoped Jira tokens using the official API gateway.
# JIRA_CLOUD_ID=11111111-1111-4111-8111-111111111111
# JIRA_ISSUE_TYPE=Task
# JIRA_LINK_TYPE=Blocks
